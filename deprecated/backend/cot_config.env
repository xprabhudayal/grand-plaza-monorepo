# Chain of Thought (COT) Configuration
# =====================================

# Enable COT reasoning for LLM responses
# When enabled, the LLM will show step-by-step reasoning before responding
# This helps less capable models perform better on complex tasks
ENABLE_COT=false

# COT Mode Selection
# - simple: Basic step-by-step reasoning
# - structured: Detailed 5-step reasoning framework
# - adaptive: Context-aware reasoning that changes based on conversation phase
COT_MODE=adaptive

# LLM Model Type for COT
# - groq: Use Groq models (faster, good for simple tasks)
# - openai: Use OpenAI models (more capable, better for complex reasoning)
LLM_MODEL_TYPE=groq

# COT-specific model overrides (optional)
# Use a more capable model when COT is enabled
COT_GROQ_MODEL_NAME=mixtral-8x7b-32768
COT_OPENAI_MODEL_NAME=gpt-4

# COT Reasoning Visibility
# - hidden: Only show final response to user
# - debug: Log reasoning to console for debugging
# - visible: Include reasoning in response (for testing)
COT_REASONING_VISIBILITY=debug

# COT Performance Settings
# Maximum tokens for COT reasoning (separate from response)
COT_MAX_REASONING_TOKENS=500
COT_MAX_RESPONSE_TOKENS=500

# COT Trigger Conditions (comma-separated)
# Automatically enable COT for specific intents
# Options: menu_inquiry, order_placement, order_modification, complex_query
COT_AUTO_ENABLE_FOR_INTENTS=complex_query,order_modification

# COT Fallback Behavior
# What to do if COT reasoning fails
# - direct: Fall back to direct LLM response
# - retry: Retry with simpler COT prompt
# - error: Return error message
COT_FALLBACK_BEHAVIOR=direct